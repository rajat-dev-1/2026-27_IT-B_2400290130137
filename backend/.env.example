# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Neon PostgreSQL
# Runtime: pooled endpoint hostname includes -pooler
DATABASE_URL=
# Migrations/admin operations: direct endpoint without -pooler
DATABASE_URL_DIRECT=

# Redis — use redis:// for local, rediss:// for TLS (Upstash, etc.)
REDIS_URL=redis://localhost:6379

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Application session security
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
TOKEN_ENCRYPTION_KEY=base64_or_hex_encoded_32_byte_key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Groq AI settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Scan limits
SCAN_MAX_FILE_SIZE_BYTES=524288
SCAN_MAX_FILES_PER_REPO=500
